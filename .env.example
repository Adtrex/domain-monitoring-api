# Copy to .env and fill in real values:  cp .env.example .env
# In production the whole file lives in the ENV_FILE GitHub secret and is
# written to the server on every deploy.

# ============================================
# Django core
# ============================================
DEBUG=False
ALLOWED_HOSTS=api.example.com,localhost,127.0.0.1
# Generate with: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me

# ============================================
# Database (PostgreSQL)
# ============================================
DB_ENGINE=django.db.backends.postgresql
DB_NAME=domainscan
DB_USER=domainscan
DB_PASSWORD=change-me
# Use the compose service name (e.g. "db") when running in Docker
DB_HOST=localhost
DB_PORT=5432

# ============================================
# CORS
# ============================================
CORS_ALLOWED_ORIGINS=https://app.example.com,http://localhost:3000
# For development only - allows all origins (NOT for production!)
CORS_ALLOW_ALL_ORIGINS=False
CORS_EXPOSE_HEADERS=Content-Disposition

# ============================================
# Groq - AI-generated remediation in reports
# Get your key at https://console.groq.com
# ============================================
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# ============================================
# Email / SMTP (used for organisation invitations)
# ============================================
# NOTE: while DEBUG=True the default backend is the console (emails print to the
# terminal, NOT sent). The line below forces real SMTP regardless of DEBUG.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Port 587 = STARTTLS (TLS=True, SSL=False). Port 465 = implicit SSL (TLS=False, SSL=True).
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=no-reply@example.com

# Invite link target - must point at your frontend's accept-invite page.
FRONTEND_URL=https://app.example.com
INVITE_PATH=/accept-invite

# ============================================
# JWT lifetimes (optional overrides; defaults: access 60 min, refresh 7 days)
# ============================================
# JWT_ACCESS_MINUTES=60
# JWT_REFRESH_DAYS=7

# ============================================
# Default org + admin login for `python manage.py seed_default_org`
# ============================================
DEFAULT_ORG_NAME=Default Organisation
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=change-me
