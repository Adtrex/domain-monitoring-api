          formInputs.forEach(input => {\n                input.addEventListener(\"input\", function() {\n                    if (errorAlert) {\n                        errorAlert.style.display = \"none\";\n                    } else if(successAlert) {\n                        successAlert.style.display = \"none\";\n                    }\n                });\n            });\n        });\n\n        function togglePasswordVisibility() {\n            const input = document.getElementById(\"password\");\n            const icon = document.getElementById(\"togglePassword\");\n        \n            if (input.type === \"password\") {\n                input.type = \"text\";\n                icon.classList.remove(\"fa-eye-slash\");\n                icon.classList.add(\"fa-eye\");\n            } else {\n                input.type = \"password\";\n                icon.classList.remove(\"fa-eye\");\n                icon.classList.add(\"fa-eye-slash\");\n            }\n        }\n    </script>\n\n\n            </section>\n            <!-- <footer class=\"main-footer text-center\">\n                <p class=\"font-xs\">\n                    <script>\n                        document.write(new Date().getFullYear());\n                    </script>\n                    \u00c2\u00a9, Nest - HTML Ecommerce Template .\n                </p> \n                <p class=\"font-xs mb-30\">All rights reserved</p>\n            </footer> -->\n        </main>\n        <script src=\"https://app.zigaara.com/js/vendors/jquery-3.6.0.min.js\"></script>\n        <script src=\"https://app.zigaara.com/js/vendors/bootstrap.bundle.min.js\"></script>\n        <script src=\"https://app.zigaara.com/js/vendors/jquery.fullscreen.min.js\"></script>\n        <!-- Main Script -->\n        <script src=\"https://app.zigaara.com/js/main.js?v=1.0\" type=\"text/javascript\"></script>\n\n            <script defer src=\"https://static.cloudflareinsights.com/beacon.min.js/vcd15cbe7772f49c399c6a5babf22c1241717689176015\" 