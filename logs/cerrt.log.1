          "https://github.com/vercel/next.js/commit/6b12c60c61ee80cb0443ccd20de82ca9b4422ddd",
          "https://vercel.com/changelog/cve-2025-57752"
        ]
      },
      {
        "atOrAbove": "0.9.9",
