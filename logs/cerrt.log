\n    <!-- Collapsible Nav -->\n     <div class=\"collapse navbar-collapse justify-content-between\" id=\"navbarNav\">\n      <!-- Centered Nav Links -->\n      <ul class=\"navbar-nav mx-auto mb-2 mb-lg-0\">\n        <li class=\"nav-item\"><a class=\"nav-link\" href=\"https://innovation.nitda.gov.ng\">Home</a></li>\n        <li class=\"nav-item\"><a class=\"nav-link\" href=\"https://innovation.nitda.gov.ng/challenges\">Challenges</a></li>\n        <li class=\"nav-item\"><a class=\"nav-link\" href=\"https://innovation.nitda.gov.ng#about\">About</a></li>\n        <li class=\"nav-item\"><a class=\"nav-link\" href=\"https://innovation.nitda.gov.ng#timeline\">Timeline</a></li>\n      </ul>\n\n      <!-- Auth Buttons (visible on all screens) -->\n      <div class=\"d-flex align-items-center\">\n                        <a href=\"https://innovation.nitda.gov.ng/login\" class=\"btn btn-outline-primary me-2\">Login</a>\n              <a href=\"https://innovation.nitda.gov.ng/register\" class=\"btn btn-primary\">Register</a>\n                </div>\n    </div>\n  </div>        </nav>\n\n        \n    <section class=\"hero text-center bg-light\">\n    <div class=\"container\">\n        <h1 class=\"fw-bold\">Transform Ideas into Impact</h1>\n        <p class=\"lead mt-3\">Join Nigeria's premier innovation challenge platform to solve real-world problems, collaborate with talented individuals, and bring your innovative solutions to life.</p>\n        <div class=\"mt-4\">\n            <div class=\"d-grid gap-3 d-md-flex justify-content-md-center\">\n                <a href=\"https://innovation.nitda.gov.ng/register\" class=\"btn btn-hero me-2\">Join the Challenge</a>\n                <a href=\"https://innovation.nitda.gov.ng/challenges\" class=\"btn btn-outline-hero\">View Challenges</a>\n            </div>\n        </div>\n    </div>\n    </section>\n\n    <!-- How It Works -->\n    <section class=\"py-5 text-center how-it-works\">\n    <div class=\"container\">\n        <h2 class=\"fw-bold\">How It Works</h2>\n        <p class=\"mb-5\">Four simple steps to transform your ideas into reality</p>\n        <div class=\"row g-4\">\n        \n        <div class=\"col-md-3\">\n            <div class=\"icon-circle mb-3\">\n            <i class=\"bi bi-person-plus\"></i>\n            </div>\n            <h5>Register & Join</h5>\n            <p>Create your account and become part of our innovation community</p>\n        </div>\n        \n        <div class=\"col-md-3\">\n            <div class=\"icon-circle mb-3\">\n            <i class=\"bi bi-people\"></i>\n            </div>\n            <h5>Form Teams</h5>\n            <p>Collaborate with others to bring diverse skills and perspectives</p>\n        </div>\n        \n        <div class=\"col-md-3\">\n            <div class=\"icon-circle mb-3\">\n            <i class=\"bi bi-lightbulb\"></i>\n            </div>\n            <h5>Submit Ideas</h5>\n            <p>Present your innovative solutions to real-world challenges</p>\n        </div>\n        \n        <div class=\"col-md-3\">\n            <div class=\"icon-circle mb-3\">\n            <i class=\"bi bi-trophy\"></i>\n            </div>\n            <h5>Get Judged</h5>\n            <p>Receive expert feedback and compete for recognition and prizes</p>\n        </div>\n\n        </div>\n    </div>\n    </section>\n\n    <!-- About -->\n    <section class=\"py-5 bg-light\" id=\"about\">\n    <div class=\"container\">\n        <div class=\"row g-4\">\n            <div class=\"col-lg-7\">\n                <h2 class=\"fw-bold\">About NITDA Idea to Impact</h2>\n                <p>The NITDA Idea to Impact is designed to build the culture of innovation and harness the creative potential of the Agency's staff, Corp members and Industrial Training students. It provides a platform for them to ideate, solve and innovate on challenges that accelerate NITDA\u00e2\u20ac\u2122s productivity and superior performance, thereby positioning NITDA at the forefront of the digital economy growth.</p>\n                <p>Our mission is to foster a culture of innovation, support technological advancement, and create sustainable solutions that empower the Agency to drive digital transformation in Nigeria.  </p>\n                <ul class=\"list-unstyled feature-list\">\n                    <li class=\"d-flex align-items-center mb-2\">\n                        <div class=\"icon-circle me-2\">\n                            <i class=\"bi bi-check-lg\"></i>\n                        </div>\n                        <span>Community-driven challenge selection</span>\n                    </li>\n                    <li class=\"d-flex align-items-center mb-2\">\n                        <div class=\"icon-circle me-2\">\n                            <i class=\"bi bi-check-lg\"></i>\n                        </div>\n                        <span>Expert judging and mentorship</span>\n                    </li>\n                    <li class=\"d-flex align-items-center\">\n                        <div class=\"icon-circle me-2\">\n                            <i class=\"bi bi-check-lg\"></i>\n                        </div>\n                        <span>Prizes and implementation support</span>\n                    </li>\n                </ul>\n            </div>\n            <div class=\"col-lg-5\">\n                <div class=\"p-4 bg-white shadow-sm eligibility\">\n                    <h4>Who Can Participate</h4>\n                    <ul class=\"list-unstyled feature-list mt-3\">\n                        <li class=\"d-flex align-items-center mb-2\">\n                            <div class=\"icon-circle me-2\">\n                                <i class=\"bi bi-check-lg\"></i>\n                            </div>\n                            <span>Interested Staff</span>\n                        </li>\n                        <li class=\"d-flex align-items-center mb-2\">\n                            <div class=\"icon-circle me-2\">\n                                <i class=\"bi bi-check-lg\"></i>\n                            </div>\n                            <span>Corp Members</span>\n                        </li>\n                        <li class=\"d-flex align-items-center mb-2\">\n                            <div class=\"icon-circle me-2\">\n                                <i class=\"bi bi-check-lg\"></i>\n                            </div>\n                            <span>Industrial Training Students</span>\n                        </li>\n                        <li class=\"d-flex align-items-center mb-2\">\n                            <div class=\"icon-circle me-2\">\n                                <i class=\"bi bi-check-lg\"></i>\n                            </div>\n                            <span>Invited External Guests </span>\n                        </li>\n                    </ul>\n                </div>\n            </div>\n        </div>\n    </div>\n    </section>\n\n    <!-- Timeline -->\n    <section class=\"py-5 bg-light\" id=\"timeline\">\n        <div class=\"container\">\n            <h2 class=\"fw-bold text-center mb-2\">Challenge Timeline</h2>\n            <p class=\"text-center mb-5\">Key dates for the current innovation cycle</p>\n\n            <div class=\"timeline\">\n                                    \n                    <div class=\"timeline-item shadow-sm rounded p-4 d-flex align-items-start justify-content-between mt-3\">\n                        <div class=\"d-flex\">\n                            <div class=\"timeline-marker \n                                         bg-success\n                                         \n                                        text-white me-3\">\n                                1\n                            </div>\n                            <div class=\"timeline-content\">\n                                <h5 class=\"fw-semibold\">Challenge Submission</h5>\n                                <p class=\"mb-1 text-muted\">\n                    