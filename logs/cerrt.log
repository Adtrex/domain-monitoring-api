an>\n                    </div>\n                                    \n                    <div class=\"timeline-item shadow-sm rounded p-4 d-flex align-items-start justify-content-between mt-3\">\n                        <div class=\"d-flex\">\n                            <div class=\"timeline-marker \n                                         bg-success\n                                         \n                                        text-white me-3\">\n                                5\n                            </div>\n                            <div class=\"timeline-content\">\n                                <h5 class=\"fw-semibold\">Judging &amp; Review</h5>\n                                <p class=\"mb-1 text-muted\">\n                                    Oct 10, 2025\n                                    -\n                                    Oct 10, 2025\n                                </p>\n                                <small>Expert judges evaluate submissions and provide feedback</small>\n                            </div>\n                        </div>\n                        <span class=\"badge bg-success-subtle text-success fw-semibold px-3 py-1\">Completed</span>\n                    </div>\n                                    \n                    <div class=\"timeline-item shadow-sm rounded p-4 d-flex align-items-start justify-content-between mt-3\">\n                        <div class=\"d-flex\">\n                            <div class=\"timeline-marker \n                                         bg-success\n                                         \n                                        text-white me-3\">\n                                6\n                            </div>\n                            <div class=\"timeline-content\">\n                                <h5 class=\"fw-semibold\">Winner Announcement</h5>\n                                <p class=\"mb-1 text-muted\">\n                                    Oct 10, 2025\n      